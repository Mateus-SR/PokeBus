<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TemplateNavegacaoMaui.Pages.AboutPage"
    Title="Sobre"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout Padding="24" Spacing="16"
                         VerticalOptions="Center">
        <Label Text="Sobre o aplicativo"
               FontSize="26" FontAttributes="Bold"
               TextColor="{StaticResource PrimaryColor}"
               HorizontalTextAlignment="Center" />
        <Label Text="Página independente acessada pelo menu lateral. Use este espaço para apresentar o projeto."
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
