<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
  x:Class="TemplateNavegacaoMaui.Pages.MainPage"
  Title="PokéBus Monitoramento"
  BackgroundColor="{StaticResource PageBackground}"
>
  <Grid x:Name="PageLayout" RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="14">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroupList>
        <VisualStateGroup x:Name="ResponsiveStates">
          <VisualState x:Name="Compact">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Property="Padding" Value="10" />
              <Setter TargetName="PageTitle" Property="Label.FontSize" Value="30" />
              <Setter TargetName="PageDescription" Property="Label.FontSize" Value="18" />
              <Setter TargetName="ToolbarGrid" Property="Grid.ColumnDefinitions" Value="*" />
              <Setter TargetName="ToolbarGrid" Property="Grid.RowDefinitions" Value="Auto,Auto,Auto" />
              <Setter TargetName="InfoCard" Property="Grid.Row" Value="0" />
              <Setter TargetName="InfoCard" Property="Grid.Column" Value="0" />
              <Setter TargetName="StatusLabel" Property="Grid.Row" Value="1" />
              <Setter TargetName="StatusLabel" Property="Grid.Column" Value="0" />
              <Setter TargetName="AtualizarButton" Property="Grid.Row" Value="2" />
              <Setter TargetName="AtualizarButton" Property="Grid.Column" Value="0" />
              <Setter TargetName="AtualizarButton" Property="VisualElement.HorizontalOptions" Value="Start" />
              <Setter TargetName="InfoCard" Property="Label.FontSize" Value="16" />
              <Setter TargetName="StatusLabel" Property="Label.FontSize" Value="16" />
              <Setter TargetName="AtualizarButton" Property="Button.FontSize" Value="16" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Intermediate">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="600" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Property="Padding" Value="14" />
              <Setter TargetName="PageTitle" Property="Label.FontSize" Value="36" />
              <Setter TargetName="PageDescription" Property="Label.FontSize" Value="22" />
              <Setter TargetName="ToolbarGrid" Property="Grid.ColumnDefinitions" Value="*" />
              <Setter TargetName="ToolbarGrid" Property="Grid.RowDefinitions" Value="Auto,Auto,Auto" />
              <Setter TargetName="InfoCard" Property="Grid.Row" Value="0" />
              <Setter TargetName="InfoCard" Property="Grid.Column" Value="0" />
              <Setter TargetName="StatusLabel" Property="Grid.Row" Value="1" />
              <Setter TargetName="StatusLabel" Property="Grid.Column" Value="0" />
              <Setter TargetName="AtualizarButton" Property="Grid.Row" Value="2" />
              <Setter TargetName="AtualizarButton" Property="Grid.Column" Value="0" />
              <Setter TargetName="InfoCard" Property="Label.FontSize" Value="20" />
              <Setter TargetName="StatusLabel" Property="Label.FontSize" Value="20" />
              <Setter TargetName="AtualizarButton" Property="Button.FontSize" Value="20" />
              <Setter TargetName="EmptyTitle" Property="Label.FontSize" Value="22" />
              <Setter TargetName="EmptyDescription" Property="Label.FontSize" Value="22" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="WideIntermediate">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="800" />
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Expanded">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1000" />
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>
    <VerticalStackLayout Grid.Row="0" Spacing="5">
      <Label
        x:Name="PageTitle"
        Text="PokéBus Monitoramento"
        FontFamily="PokemonEmerald"
        FontSize="44"
        FontAttributes="Bold"
        TextColor="{StaticResource PrimaryColor}"
      />

      <Label
        x:Name="PageDescription"
        Text="Previsões de chegada consultadas em tempo real, usando como base o Backend do Busca Bus, nosso Projeto Integrado do 4º semestre."
        FontFamily="PokemonEmerald"
        FontSize="30"
        TextColor="Gray"
      />
    </VerticalStackLayout>

    <Grid x:Name="ToolbarGrid" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="15">
      <Label
        Grid.Column="1"
        x:Name="StatusLabel"
        Text="Aguardando consulta..."
        FontFamily="PokemonEmerald"
        VerticalOptions="Center"
        FontSize="24"
        TextColor="Gray"
      />

      <Label
        Grid.Column="0"
        x:Name="InfoCard"
        Text="Clique em um card para ver informações sobre o Pokémon."
        FontFamily="PokemonEmerald"
        VerticalOptions="Center"
        FontSize="24"
        TextColor="Gray"
      />

      <Button
        Grid.Column="2"
        x:Name="AtualizarButton"
        FontSize="24"
        Text="Atualizar"
        FontFamily="PokemonEmerald"
        Padding="14,9"
        Clicked="OnAtualizarClicked"
      />
    </Grid>

    <Grid Grid.Row="2">
      <CollectionView ItemsSource="{Binding Onibus}" SelectionMode="None">
        <CollectionView.EmptyView>
          <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroupList>
                <VisualStateGroup x:Name="EmptyViewStates">
                  <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                      <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                      <Setter TargetName="EmptyTitle" Property="Label.FontSize" Value="20" />
                      <Setter TargetName="EmptyDescription" Property="Label.FontSize" Value="18" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Intermediate">
                    <VisualState.StateTriggers>
                      <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                      <Setter TargetName="EmptyTitle" Property="Label.FontSize" Value="22" />
                      <Setter TargetName="EmptyDescription" Property="Label.FontSize" Value="22" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers>
                      <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Label
              x:Name="EmptyTitle"
              Text="Nenhum veículo para exibir"
              FontFamily="PokemonEmerald"
              FontSize="26"
              TextColor="Gray"
              HorizontalTextAlignment="Center"
            />

            <Label
              x:Name="EmptyDescription"
              Text="Use Atualizar para consultar novamente."
              FontFamily="PokemonEmerald"
              FontSize="26"
              TextColor="Gray"
              HorizontalTextAlignment="Center"
            />
          </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Frame
              Padding="8"
              Margin="40"
              CornerRadius="60"
              HasShadow="False"
              BorderColor="#D8E5E2"
              BackgroundColor="White"
            >
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                  <VisualStateGroup x:Name="CardSizeStates">
                    <VisualState x:Name="Compact">
                      <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                      </VisualState.StateTriggers>
                      <VisualState.Setters>
                        <Setter Property="Margin" Value="4,6" />
                        <Setter Property="CornerRadius" Value="24" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Intermediate">
                      <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                      </VisualState.StateTriggers>
                      <VisualState.Setters>
                        <Setter Property="Margin" Value="10" />
                        <Setter Property="CornerRadius" Value="36" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                      <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                      </VisualState.StateTriggers>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateGroupList>
              </VisualStateManager.VisualStateGroups>
              <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOnibusTapped" />
              </Frame.GestureRecognizers>

              <Grid ColumnDefinitions="*,Auto,144" ColumnSpacing="10">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroupList>
                    <VisualStateGroup x:Name="CardContentStates">
                      <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                          <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                          <Setter Property="ColumnDefinitions" Value="*,Auto,84" />
                          <Setter Property="ColumnSpacing" Value="6" />
                          <Setter TargetName="LineInfo" Property="View.Margin" Value="8" />
                          <Setter TargetName="LineCode" Property="Label.FontSize" Value="30" />
                          <Setter TargetName="LineDirection" Property="Label.FontSize" Value="18" />
                          <Setter TargetName="PokemonName" Property="Label.FontSize" Value="18" />
                          <Setter TargetName="PredictionTitle" Property="Label.FontSize" Value="14" />
                          <Setter TargetName="PredictionValue" Property="Label.FontSize" Value="30" />
                          <Setter TargetName="BusPokemonSprite" Property="VisualElement.WidthRequest" Value="84" />
                          <Setter TargetName="BusPokemonSprite" Property="VisualElement.HeightRequest" Value="84" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Intermediate">
                        <VisualState.StateTriggers>
                          <AdaptiveTrigger MinWindowWidth="600" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                          <Setter Property="ColumnDefinitions" Value="*,Auto,112" />
                          <Setter Property="ColumnSpacing" Value="8" />
                          <Setter TargetName="LineInfo" Property="View.Margin" Value="12" />
                          <Setter TargetName="LineCode" Property="Label.FontSize" Value="38" />
                          <Setter TargetName="LineDirection" Property="Label.FontSize" Value="26" />
                          <Setter TargetName="PokemonName" Property="Label.FontSize" Value="22" />
                          <Setter TargetName="PredictionTitle" Property="Label.FontSize" Value="18" />
                          <Setter TargetName="PredictionValue" Property="Label.FontSize" Value="40" />
                          <Setter TargetName="BusPokemonSprite" Property="VisualElement.WidthRequest" Value="112" />
                          <Setter TargetName="BusPokemonSprite" Property="VisualElement.HeightRequest" Value="112" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Expanded">
                        <VisualState.StateTriggers>
                          <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <!-- Informações da linha -->
                <VerticalStackLayout
                  x:Name="LineInfo"
                  Grid.Column="0"
                  Margin="20"
                  Spacing="5"
                  VerticalOptions="Center"
                >
                  <!-- Código da linha -->
                  <Label
                    x:Name="LineCode"
                    Text="{Binding CodigoLetreiro}"
                    FontSize="54"
                    TextColor="{StaticResource PrimaryColor}"
                    FontFamily="PokemonEmerald"
                  />

                  <!-- Sentido -->
                  <Label
                    x:Name="LineDirection"
                    Text="{Binding SentidoLinha}"
                    FontSize="34"
                    TextColor="{StaticResource PrimaryColor}"
                    FontFamily="PokemonEmerald"
                  />

                  <!-- Nome do Pokémon -->
                  <Label
                    x:Name="PokemonName"
                    Text="{Binding PokemonName}"
                    FontSize="30"
                    FontFamily="PokemonEmerald"
                    TextColor="#263D3A"
                  />
                </VerticalStackLayout>

                <!-- Previsão -->
                <VerticalStackLayout
                  x:Name="PredictionInfo"
                  Grid.Column="1"
                  Spacing="2"
                  VerticalOptions="Center"
                  HorizontalOptions="End"
                >
                  <Label
                    x:Name="PredictionTitle"
                    Text="PREVISÃO"
                    FontFamily="PokemonEmerald"
                    FontSize="30"
                    TextColor="Gray"
                    HorizontalTextAlignment="End"
                  />

                  <Label
                    x:Name="PredictionValue"
                    Text="{Binding Previsao}"
                    FontFamily="PokemonEmerald"
                    FontSize="54"
                    TextColor="#263D3A"
                    HorizontalTextAlignment="End"
                  />
                </VerticalStackLayout>

                <!-- Sprite do Pokémon -->
                <controls:PokemonSpriteView
                  x:Name="BusPokemonSprite"
                  Grid.Column="2"
                  Url="{Binding PokemonSpriteUrl}"
                  WidthRequest="144"
                  HeightRequest="144"
                  VerticalOptions="Center"
                  HorizontalOptions="Center"
                />
              </Grid>
            </Frame>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <ActivityIndicator
        x:Name="LoadingIndicator"
        IsVisible="False"
        IsRunning="False"
        Color="{StaticResource PrimaryColor}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
      />
    </Grid>
  </Grid>
</ContentPage>
