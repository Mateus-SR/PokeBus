<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TemplateNavegacaoMaui.Pages.SecondaryDetailsPage"
    Title="Página complementar"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout Padding="24" Spacing="18"
                         VerticalOptions="Center">
        <Label Text="Página complementar"
               FontSize="26" FontAttributes="Bold"
               TextColor="{StaticResource PrimaryColor}"
               HorizontalTextAlignment="Center" />
        <Label Text="Você pode empilhar outras páginas seguindo este mesmo padrão."
               HorizontalTextAlignment="Center" />
        <Button Text="Voltar"
                Clicked="OnBackClicked" />
    </VerticalStackLayout>
</ContentPage>
