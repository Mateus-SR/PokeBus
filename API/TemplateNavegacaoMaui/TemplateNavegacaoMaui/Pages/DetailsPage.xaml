<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TemplateNavegacaoMaui.Pages.DetailsPage"
    Title="Detalhes"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout Padding="24" Spacing="18"
                         VerticalOptions="Center">
        <Label Text="Página de detalhes"
               FontSize="26" FontAttributes="Bold"
               TextColor="{StaticResource PrimaryColor}"
               HorizontalTextAlignment="Center" />
        <Label Text="Esta página foi aberta por navegação em pilha."
               HorizontalTextAlignment="Center" />
        <Button Text="Abrir próxima página"
                Clicked="OnOpenNextClicked" />
        <Button Text="Voltar"
                BackgroundColor="#526B68"
                Clicked="OnBackClicked" />
    </VerticalStackLayout>
</ContentPage>
