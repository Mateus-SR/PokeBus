<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TemplateNavegacaoMaui.Pages.PokemonDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
    Title="Pokémon"
    BackgroundColor="{StaticResource PageBackground}">

    <!--  Cabeçalho fixo  -->
    <Grid
        Padding="20"
        RowDefinitions="Auto,*"
        RowSpacing="14">

        <Frame
            Grid.Row="0"
            BackgroundColor="White"
            BorderColor="#D8E5E2"
            CornerRadius="30"
            HasShadow="False">

            <Grid ColumnDefinitions="*,Auto,Auto">

                <!--  Identificação  -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="3"
                    VerticalOptions="Center">

                    <Button
                        x:Name="VoltarButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnBackClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="26"
                        HorizontalOptions="Start"
                        Text="VOLTAR"
                        TextColor="White"
                        WidthRequest="120" />

                    <VerticalStackLayout Margin="0,0,0,30">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="PokemonEmerald"
                            FontSize="40"
                            Text="{Binding Pokemon.Name}"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="24"
                            Text="{Binding Pokemon.Id, StringFormat='Pokédex #{0}'}"
                            TextColor="Gray" />
                    </VerticalStackLayout>

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        Text="{Binding CodigoLetreiro, StringFormat='Linha {0}'}"
                        TextColor="Black" />

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        Text="{Binding SentidoLinha, StringFormat='Sentido {0}'}"
                        TextColor="Black" />

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="20"
                        Text="{Binding Id, StringFormat='ID do ônibus: {0}'}"
                        TextColor="Gray" />

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        Text="{Binding Previsao, StringFormat='Previsão: {0}'}"
                        TextColor="{StaticResource PrimaryColor}" />



                </VerticalStackLayout>

                <!--  Sprite frontal  -->
                <controls:PokemonSpriteView
                    Grid.Column="1"
                    HeightRequest="288"
                    HorizontalOptions="Center"
                    Url="{Binding Pokemon.SpriteUrl}"
                    VerticalOptions="Center"
                    WidthRequest="288" />

                <!--  Sprite traseiro  -->
                <controls:PokemonSpriteView
                    Grid.Column="2"
                    HeightRequest="288"
                    HorizontalOptions="Center"
                    Url="{Binding Pokemon.BackSpriteUrl}"
                    VerticalOptions="Center"
                    WidthRequest="288" />

            </Grid>
        </Frame>

        <!--  Conteúdo rolável  -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="0" Spacing="14">
                <!--  Informações e atributos base lado a lado  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                    <!--  Coluna 1: Informações  -->
                    <VerticalStackLayout
                        Grid.Column="0"
                        HorizontalOptions="Fill"
                        Spacing="14"
                        VerticalOptions="Start">

                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="34"
                            Text="Informações"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Frame
                            Padding="18"
                            BackgroundColor="White"
                            BorderColor="#D8E5E2"
                            CornerRadius="30"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="14">

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="24"
                                        Text="Tipo"
                                        TextColor="Gray" />

                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="30"
                                        Text="{Binding Pokemon.TypesText}"
                                        TextColor="#263D3A" />
                                </VerticalStackLayout>

                                <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                    <VerticalStackLayout Spacing="5">
                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="24"
                                            Text="Altura"
                                            TextColor="Gray" />

                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="30"
                                            Text="{Binding Pokemon.HeightText}"
                                            TextColor="#263D3A" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5">

                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="24"
                                            Text="Peso"
                                            TextColor="Gray" />

                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="30"
                                            Text="{Binding Pokemon.WeightText}"
                                            TextColor="#263D3A" />
                                    </VerticalStackLayout>

                                </Grid>

                                <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="24"
                                        Text="Experiência-base"
                                        TextColor="Gray" />

                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="30"
                                        Text="{Binding Pokemon.BaseExperienceText}"
                                        TextColor="#263D3A" />
                                </VerticalStackLayout>

                                <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="24"
                                        Text="Habilidades"
                                        TextColor="Gray" />

                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="26"
                                        Text="{Binding Pokemon.AbilitiesText}"
                                        TextColor="#263D3A" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!--  Coluna 2: Pokédex e atributos base  -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Fill"
                        Spacing="14"
                        VerticalOptions="Start">

                        <!--  Descrição da Pokédex  -->
                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="34"
                            Text="Descrição da Pokédex"
                            TextColor="{StaticResource PrimaryColor}" />


                        <Frame
                            Padding="18"
                            BackgroundColor="White"
                            BorderColor="#D8E5E2"
                            CornerRadius="30"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="8">

                                <!--  Descrição do Pokémon  -->
                                <Label
                                    x:Name="PokedexDescriptionLabel"
                                    FontFamily="PokemonEmerald"
                                    FontSize="26"
                                    LineBreakMode="WordWrap"
                                    TextColor="Black"
                                    VerticalTextAlignment="Start" />

                                <!--  Mensagem durante a tradução  -->
                                <Label
                                    x:Name="TraducaoStatusLabel"
                                    Margin="0,10,0,0"
                                    FontFamily="PokemonEmerald"
                                    FontSize="26"
                                    IsVisible="False"
                                    Text="Gemini está traduzindo a descrição... Por favor, aguarde."
                                    TextColor="Gray" />

                            </VerticalStackLayout>
                        </Frame>


                        <!--  Atributos base  -->
                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="34"
                            Text="Atributos base"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Frame
                            Padding="18"
                            BackgroundColor="White"
                            BorderColor="#D8E5E2"
                            CornerRadius="30"
                            HasShadow="False">

                            <Label
                                FontFamily="PokemonEmerald"
                                FontSize="26"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                Text="{Binding Pokemon.StatsText}"
                                TextColor="#263D3A" />

                        </Frame>

                    </VerticalStackLayout>
                </Grid>



                <!--  Golpes  -->
                <Label
                    FontFamily="PokemonEmerald"
                    FontSize="34"
                    Text="Golpes"
                    TextColor="{StaticResource PrimaryColor}" />

                <FlexLayout
                    AlignContent="Start"
                    AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding Pokemon.Golpes}"
                    Direction="Row"
                    JustifyContent="Start"
                    Wrap="Wrap">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>

                            <Frame
                                Margin="0,0,8,10"
                                Padding="14"
                                BackgroundColor="White"
                                BorderColor="#D8E5E2"
                                CornerRadius="20"
                                FlexLayout.Basis="20%"
                                HasShadow="False"
                                VerticalOptions="Start">

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="7">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <!--  Nome  -->
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontFamily="PokemonEmerald"
                                            FontSize="26"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding Nome}"
                                            TextColor="#263D3A"
                                            TextTransform="Uppercase"
                                            VerticalTextAlignment="Center" />

                                        <!--  Tipo  -->
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="PokemonEmerald"
                                            FontSize="18"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding Tipo}"
                                            TextColor="{StaticResource PrimaryColor}"
                                            VerticalTextAlignment="Center" />

                                    </Grid>

                                    <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                    <!--  Potência e precisão  -->
                                    <Grid ColumnDefinitions="*,*">

                                        <VerticalStackLayout Spacing="3">
                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="16"
                                                Text="Potência"
                                                TextColor="Gray" />

                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="20"
                                                Text="{Binding Potencia}"
                                                TextColor="#263D3A" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">

                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="16"
                                                Text="Precisão"
                                                TextColor="Gray" />

                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="20"
                                                Text="{Binding Precisao, StringFormat='{0}%'}"
                                                TextColor="#263D3A" />
                                        </VerticalStackLayout>

                                    </Grid>

                                </VerticalStackLayout>
                            </Frame>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
