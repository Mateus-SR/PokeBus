<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TemplateNavegacaoMaui.Pages.PokemonDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
    Title="Pokémon"
    BackgroundColor="{StaticResource PageBackground}">

    <!--  Cabeçalho fixo  -->
    <Grid
        x:Name="PageLayout"
        Padding="20"
        RowDefinitions="Auto,*"
        RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="RowSpacing" Value="8" />
                            <Setter TargetName="HeaderFrame" Property="Frame.Padding" Value="10" />
                            <Setter TargetName="HeaderGrid" Property="Grid.ColumnDefinitions" Value="*,*" />
                            <Setter TargetName="HeaderGrid" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                            <Setter TargetName="PokemonHeaderInfo" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PokemonHeaderInfo" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PokemonHeaderInfo" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="FrontSprite" Property="Grid.Row" Value="1" />
                            <Setter TargetName="FrontSprite" Property="Grid.Column" Value="0" />
                            <Setter TargetName="FrontSprite" Property="VisualElement.WidthRequest" Value="120" />
                            <Setter TargetName="FrontSprite" Property="VisualElement.HeightRequest" Value="120" />
                            <Setter TargetName="BackSprite" Property="Grid.Row" Value="1" />
                            <Setter TargetName="BackSprite" Property="Grid.Column" Value="1" />
                            <Setter TargetName="BackSprite" Property="VisualElement.WidthRequest" Value="120" />
                            <Setter TargetName="BackSprite" Property="VisualElement.HeightRequest" Value="120" />
                            <Setter TargetName="VoltarButton" Property="Button.FontSize" Value="16" />
                            <Setter TargetName="VoltarButton" Property="VisualElement.WidthRequest" Value="100" />
                            <Setter TargetName="PokemonNameLabel" Property="Label.FontSize" Value="28" />
                            <Setter TargetName="PokemonIdLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="IdentificationStack" Property="View.Margin" Value="0" />
                            <Setter TargetName="CodigoLabel" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="SentidoLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="OnibusIdLabel" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="PrevisaoLabel" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="DetailsColumnsGrid" Property="Grid.ColumnDefinitions" Value="*" />
                            <Setter TargetName="DetailsColumnsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                            <Setter TargetName="InformationColumn" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PokedexColumn" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PokedexColumn" Property="Grid.Column" Value="0" />
                            <Setter TargetName="InformationTitle" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="PokedexTitle" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="TypeTitle" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="TypesValue" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="HeightTitle" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="HeightValue" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="WeightTitle" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="WeightValue" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="ExperienceTitle" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="ExperienceValue" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="AbilitiesTitle" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="AbilitiesValue" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="PokedexDescriptionLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="TraducaoStatusLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="StatsTitle" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="StatsValue" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="MovesTitle" Property="Label.FontSize" Value="26" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Intermediate">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="600" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="14" />
                            <Setter TargetName="HeaderFrame" Property="Frame.Padding" Value="14" />
                            <Setter TargetName="FrontSprite" Property="VisualElement.WidthRequest" Value="200" />
                            <Setter TargetName="FrontSprite" Property="VisualElement.HeightRequest" Value="200" />
                            <Setter TargetName="BackSprite" Property="VisualElement.WidthRequest" Value="200" />
                            <Setter TargetName="BackSprite" Property="VisualElement.HeightRequest" Value="200" />
                            <Setter TargetName="PokemonNameLabel" Property="Label.FontSize" Value="34" />
                            <Setter TargetName="PokemonIdLabel" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="CodigoLabel" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="SentidoLabel" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="OnibusIdLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="PrevisaoLabel" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="InformationTitle" Property="Label.FontSize" Value="30" />
                            <Setter TargetName="PokedexTitle" Property="Label.FontSize" Value="30" />
                            <Setter TargetName="PokedexDescriptionLabel" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="StatsTitle" Property="Label.FontSize" Value="30" />
                            <Setter TargetName="StatsValue" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="MovesTitle" Property="Label.FontSize" Value="30" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <Frame
            x:Name="HeaderFrame"
            Grid.Row="0"
            BackgroundColor="White"
            BorderColor="#D8E5E2"
            CornerRadius="30"
            HasShadow="False">

            <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto,Auto">

                <!--  Identificação  -->
                <VerticalStackLayout
                    x:Name="PokemonHeaderInfo"
                    Grid.Column="0"
                    Spacing="3"
                    VerticalOptions="Center">

                    <Button
                        x:Name="VoltarButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnBackClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="26"
                        HorizontalOptions="Start"
                        Text="VOLTAR"
                        TextColor="White"
                        WidthRequest="120" />

                    <VerticalStackLayout x:Name="IdentificationStack" Margin="0,0,0,30">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="PokemonEmerald"
                            FontSize="40"
                            x:Name="PokemonNameLabel" Text="{Binding Pokemon.Name}"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="24"
                            x:Name="PokemonIdLabel" Text="{Binding Pokemon.Id, StringFormat='Pokédex #{0}'}"
                            TextColor="Gray" />
                    </VerticalStackLayout>

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        x:Name="CodigoLabel" Text="{Binding CodigoLetreiro, StringFormat='Linha {0}'}"
                        TextColor="Black" />

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        x:Name="SentidoLabel" Text="{Binding SentidoLinha, StringFormat='Sentido {0}'}"
                        TextColor="Black" />

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="20"
                        x:Name="OnibusIdLabel" Text="{Binding Id, StringFormat='ID do ônibus: {0}'}"
                        TextColor="Gray" />

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        x:Name="PrevisaoLabel" Text="{Binding Previsao, StringFormat='Previsão: {0}'}"
                        TextColor="{StaticResource PrimaryColor}" />



                </VerticalStackLayout>

                <!--  Sprite frontal  -->
                <controls:PokemonSpriteView
                    x:Name="FrontSprite"
                    Grid.Column="1"
                    HeightRequest="288"
                    HorizontalOptions="Center"
                    Url="{Binding Pokemon.SpriteUrl}"
                    VerticalOptions="Center"
                    WidthRequest="288" />

                <!--  Sprite traseiro  -->
                <controls:PokemonSpriteView
                    x:Name="BackSprite"
                    Grid.Column="2"
                    HeightRequest="288"
                    HorizontalOptions="Center"
                    Url="{Binding Pokemon.BackSpriteUrl}"
                    VerticalOptions="Center"
                    WidthRequest="288" />

            </Grid>
        </Frame>

        <!--  Conteúdo rolável  -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="0" Spacing="14">
                <!--  Informações e atributos base lado a lado  -->
                <Grid x:Name="DetailsColumnsGrid" ColumnDefinitions="*,*" ColumnSpacing="14">

                    <!--  Coluna 1: Informações  -->
                    <VerticalStackLayout
                        x:Name="InformationColumn"
                        Grid.Column="0"
                        HorizontalOptions="Fill"
                        Spacing="14"
                        VerticalOptions="Start">

                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="34"
                            x:Name="InformationTitle" Text="Informações"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Frame
                            Padding="18"
                            BackgroundColor="White"
                            BorderColor="#D8E5E2"
                            CornerRadius="30"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="14">

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="24"
                                        x:Name="TypeTitle" Text="Tipo"
                                        TextColor="Gray" />

                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="30"
                                        x:Name="TypesValue" Text="{Binding Pokemon.TypesText}"
                                        TextColor="#263D3A" />
                                </VerticalStackLayout>

                                <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                    <VerticalStackLayout Spacing="5">
                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="24"
                                            x:Name="HeightTitle" Text="Altura"
                                            TextColor="Gray" />

                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="30"
                                            x:Name="HeightValue" Text="{Binding Pokemon.HeightText}"
                                            TextColor="#263D3A" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5">

                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="24"
                                            x:Name="WeightTitle" Text="Peso"
                                            TextColor="Gray" />

                                        <Label
                                            FontFamily="PokemonEmerald"
                                            FontSize="30"
                                            x:Name="WeightValue" Text="{Binding Pokemon.WeightText}"
                                            TextColor="#263D3A" />
                                    </VerticalStackLayout>

                                </Grid>

                                <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="24"
                                        x:Name="ExperienceTitle" Text="Experiência-base"
                                        TextColor="Gray" />

                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="30"
                                        x:Name="ExperienceValue" Text="{Binding Pokemon.BaseExperienceText}"
                                        TextColor="#263D3A" />
                                </VerticalStackLayout>

                                <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="24"
                                        x:Name="AbilitiesTitle" Text="Habilidades"
                                        TextColor="Gray" />

                                    <Label
                                        FontFamily="PokemonEmerald"
                                        FontSize="26"
                                        x:Name="AbilitiesValue" Text="{Binding Pokemon.AbilitiesText}"
                                        TextColor="#263D3A" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!--  Coluna 2: Pokédex e atributos base  -->
                    <VerticalStackLayout
                        x:Name="PokedexColumn"
                        Grid.Column="1"
                        HorizontalOptions="Fill"
                        Spacing="14"
                        VerticalOptions="Start">

                        <!--  Descrição da Pokédex  -->
                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="34"
                            x:Name="PokedexTitle" Text="Descrição da Pokédex"
                            TextColor="{StaticResource PrimaryColor}" />


                        <Frame
                            Padding="18"
                            BackgroundColor="White"
                            BorderColor="#D8E5E2"
                            CornerRadius="30"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="8">

                                <!--  Descrição do Pokémon  -->
                                <Label
                                    x:Name="PokedexDescriptionLabel"
                                    FontFamily="PokemonEmerald"
                                    FontSize="26"
                                    LineBreakMode="WordWrap"
                                    TextColor="Black"
                                    VerticalTextAlignment="Start" />

                                <!--  Mensagem durante a tradução  -->
                                <Label
                                    x:Name="TraducaoStatusLabel"
                                    Margin="0,10,0,0"
                                    FontFamily="PokemonEmerald"
                                    FontSize="26"
                                    IsVisible="False"
                                    Text="Gemini está traduzindo a descrição... Por favor, aguarde."
                                    TextColor="Gray" />

                            </VerticalStackLayout>
                        </Frame>


                        <!--  Atributos base  -->
                        <Label
                            FontFamily="PokemonEmerald"
                            FontSize="34"
                            x:Name="StatsTitle" Text="Atributos base"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Frame
                            Padding="18"
                            BackgroundColor="White"
                            BorderColor="#D8E5E2"
                            CornerRadius="30"
                            HasShadow="False">

                            <Label
                                FontFamily="PokemonEmerald"
                                FontSize="26"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                x:Name="StatsValue" Text="{Binding Pokemon.StatsText}"
                                TextColor="#263D3A" />

                        </Frame>

                    </VerticalStackLayout>
                </Grid>



                <!--  Golpes  -->
                <Label
                    FontFamily="PokemonEmerald"
                    FontSize="34"
                    x:Name="MovesTitle" Text="Golpes"
                    TextColor="{StaticResource PrimaryColor}" />

                <FlexLayout
                    AlignContent="Start"
                    AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding Pokemon.Golpes}"
                    Direction="Row"
                    JustifyContent="Start"
                    Wrap="Wrap">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>

                            <Frame
                                Margin="0,0,8,10"
                                Padding="14"
                                BackgroundColor="White"
                                BorderColor="#D8E5E2"
                                CornerRadius="20"
                                FlexLayout.Basis="20%"
                                HasShadow="False"
                                VerticalOptions="Start">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="MoveCardStates">
                                            <VisualState x:Name="Compact">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Property="FlexLayout.Basis" Value="46%" />
                                                    <Setter Property="Padding" Value="10" />
                                                    <Setter TargetName="MoveName" Property="Label.FontSize" Value="18" />
                                                    <Setter TargetName="MoveType" Property="Label.FontSize" Value="14" />
                                                    <Setter TargetName="PowerTitle" Property="Label.FontSize" Value="14" />
                                                    <Setter TargetName="PowerValue" Property="Label.FontSize" Value="16" />
                                                    <Setter TargetName="AccuracyTitle" Property="Label.FontSize" Value="14" />
                                                    <Setter TargetName="AccuracyValue" Property="Label.FontSize" Value="16" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Intermediate">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="600" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Property="FlexLayout.Basis" Value="30%" />
                                                    <Setter TargetName="MoveName" Property="Label.FontSize" Value="22" />
                                                    <Setter TargetName="MoveType" Property="Label.FontSize" Value="16" />
                                                    <Setter TargetName="PowerTitle" Property="Label.FontSize" Value="16" />
                                                    <Setter TargetName="PowerValue" Property="Label.FontSize" Value="18" />
                                                    <Setter TargetName="AccuracyTitle" Property="Label.FontSize" Value="16" />
                                                    <Setter TargetName="AccuracyValue" Property="Label.FontSize" Value="18" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Expanded">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="1000" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Property="FlexLayout.Basis" Value="20%" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="7">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <!--  Nome  -->
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontFamily="PokemonEmerald"
                                            FontSize="26"
                                            LineBreakMode="WordWrap"
                                            x:Name="MoveName" Text="{Binding Nome}"
                                            TextColor="#263D3A"
                                            TextTransform="Uppercase"
                                            VerticalTextAlignment="Center" />

                                        <!--  Tipo  -->
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="PokemonEmerald"
                                            FontSize="18"
                                            HorizontalTextAlignment="End"
                                            x:Name="MoveType" Text="{Binding Tipo}"
                                            TextColor="{StaticResource PrimaryColor}"
                                            VerticalTextAlignment="Center" />

                                    </Grid>

                                    <BoxView BackgroundColor="#E5E5E5" HeightRequest="1" />

                                    <!--  Potência e precisão  -->
                                    <Grid ColumnDefinitions="*,*">

                                        <VerticalStackLayout Spacing="3">
                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="16"
                                                x:Name="PowerTitle" Text="Potência"
                                                TextColor="Gray" />

                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="20"
                                                x:Name="PowerValue" Text="{Binding Potencia}"
                                                TextColor="#263D3A" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">

                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="16"
                                                x:Name="AccuracyTitle" Text="Precisão"
                                                TextColor="Gray" />

                                            <Label
                                                FontFamily="PokemonEmerald"
                                                FontSize="20"
                                                x:Name="AccuracyValue" Text="{Binding Precisao, StringFormat='{0}%'}"
                                                TextColor="#263D3A" />
                                        </VerticalStackLayout>

                                    </Grid>

                                </VerticalStackLayout>
                            </Frame>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
