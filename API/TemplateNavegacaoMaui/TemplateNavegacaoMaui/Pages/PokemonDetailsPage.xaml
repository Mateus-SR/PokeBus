<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TemplateNavegacaoMaui.Pages.PokemonDetailsPage"
    Title="Pokémon"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="22"
                             Spacing="18">

            <!-- Identificação -->

            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding CodigoLetreiro}"
                       FontSize="14"
                       TextColor="Gray" />

                <Label Text="{Binding SentidoLinha}"
                       FontSize="13"
                       TextColor="Gray" />
            </VerticalStackLayout>

            <Frame Padding="18"
                   CornerRadius="18"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="#D8E5E2">

                <VerticalStackLayout Spacing="12">

                    <!-- Sprite -->

                    <Image Source="{Binding Pokemon.SpriteUrl}"
                           HeightRequest="190"
                           WidthRequest="190"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <!-- Nome -->

                    <Label Text="{Binding Pokemon.Name}"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}"
                           HorizontalTextAlignment="Center" />

                    <!-- Pokédex -->

                    <Label Text="{Binding Pokemon.Id,
                                  StringFormat='Pokédex #{0}'}"
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- Informações principais -->

            <Label Text="Informações"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}" />

            <Frame Padding="16"
                   CornerRadius="14"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="#D8E5E2">

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Tipo"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="Gray" />

                        <Label Text="{Binding Pokemon.TypesText}"
                               FontSize="17" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E5E5" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Altura"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="Gray" />

                            <Label Text="{Binding Pokemon.HeightText}"
                                   FontSize="17" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3">
                            <Label Text="Peso"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="Gray" />

                            <Label Text="{Binding Pokemon.WeightText}"
                                   FontSize="17" />
                        </VerticalStackLayout>

                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E5E5" />

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Experiência-base"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="Gray" />

                        <Label Text="{Binding Pokemon.BaseExperienceText}"
                               FontSize="17" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E5E5" />

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Habilidades"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="Gray" />

                        <Label Text="{Binding Pokemon.AbilitiesText}"
                               FontSize="16" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Atributos -->

            <Label Text="Atributos base"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}" />

            <Frame Padding="16"
                   CornerRadius="14"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="#D8E5E2">

                <Label Text="{Binding Pokemon.StatsText}"
                       FontSize="16"
                       LineHeight="1.5"
                       TextColor="#263D3A" />

            </Frame>

            <!-- Previsão do ônibus -->

            <Label Text="Informações do ônibus"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}" />

            <Frame Padding="16"
                   CornerRadius="14"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="#D8E5E2">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Previsão de chegada"
                           FontSize="15"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="{Binding Previsao}"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />
                </Grid>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
