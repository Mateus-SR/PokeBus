<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TemplateNavegacaoMaui.Pages.BatalhaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
    Title="Batalha PokéBus"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        x:Name="PageLayout"
        Margin="24,10"
        RowDefinitions="Auto,*"
        RowSpacing="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="Margin" Value="8,6" />
                            <Setter TargetName="BattleTitle" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="MainContentGrid" Property="Grid.ColumnDefinitions" Value="*" />
                            <Setter TargetName="MainContentGrid" Property="Grid.RowDefinitions" Value="Auto,2,*" />
                            <Setter TargetName="MainContentGrid" Property="Grid.ColumnSpacing" Value="0" />
                            <Setter TargetName="MainContentGrid" Property="Grid.RowSpacing" Value="8" />
                            <Setter TargetName="BattleFieldPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="BattleFieldPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="BattleFieldPanel" Property="Grid.RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="LayoutDivider" Property="Grid.Column" Value="0" />
                            <Setter TargetName="LayoutDivider" Property="Grid.Row" Value="1" />
                            <Setter TargetName="LayoutDivider" Property="VisualElement.WidthRequest" Value="0" />
                            <Setter TargetName="LayoutDivider" Property="VisualElement.HeightRequest" Value="2" />
                            <Setter TargetName="LayoutDivider" Property="VisualElement.HorizontalOptions" Value="Fill" />
                            <Setter TargetName="LayoutDivider" Property="VisualElement.VerticalOptions" Value="Center" />
                            <Setter TargetName="NarrationPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="NarrationPanel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="BattlePositionsGrid" Property="View.Margin" Value="0" />
                            <Setter TargetName="PokemonDistanteRow" Property="Grid.ColumnDefinitions" Value="*,108" />
                            <Setter TargetName="PokemonDistanteRow" Property="Grid.ColumnSpacing" Value="6" />
                            <Setter TargetName="PokemonProximoRow" Property="Grid.ColumnDefinitions" Value="120,*" />
                            <Setter TargetName="PokemonProximoRow" Property="Grid.ColumnSpacing" Value="4" />
                            <Setter TargetName="PokemonDistanteImage" Property="VisualElement.WidthRequest" Value="108" />
                            <Setter TargetName="PokemonDistanteImage" Property="VisualElement.HeightRequest" Value="108" />
                            <Setter TargetName="PokemonProximoImage" Property="VisualElement.WidthRequest" Value="120" />
                            <Setter TargetName="PokemonProximoImage" Property="VisualElement.HeightRequest" Value="120" />
                            <Setter TargetName="PokemonDistanteLabel" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="LinhaDistanteLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="SentidoDistanteLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="HpDistanteLabel" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="PokemonProximoLabel" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="LinhaProximoLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="SentidoProximoLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="HpProximoLabel" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="ResultadoLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="InverterPerspectivaButton" Property="Button.FontSize" Value="16" />
                            <Setter TargetName="NarrationTitle" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="StatusLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="ModeloLabel" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="NarracaoLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="TentarNovamenteButton" Property="Button.FontSize" Value="16" />
                            <Setter TargetName="ConfigurarChaveButton" Property="Button.FontSize" Value="16" />
                            <Setter TargetName="VoltarButton" Property="Button.FontSize" Value="16" />
                            <Setter TargetName="SortearNovamenteButton" Property="Button.FontSize" Value="16" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Intermediate">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="600" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="Margin" Value="12,8" />
                            <Setter TargetName="BattleTitle" Property="Label.FontSize" Value="34" />
                            <Setter TargetName="MainContentGrid" Property="Grid.ColumnDefinitions" Value="1.05*,2,0.95*" />
                            <Setter TargetName="MainContentGrid" Property="Grid.ColumnSpacing" Value="8" />
                            <Setter TargetName="BattleFieldPanel" Property="Grid.RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="BattlePositionsGrid" Property="View.Margin" Value="0" />
                            <Setter TargetName="PokemonDistanteRow" Property="Grid.ColumnDefinitions" Value="*,104" />
                            <Setter TargetName="PokemonDistanteImage" Property="VisualElement.WidthRequest" Value="104" />
                            <Setter TargetName="PokemonDistanteImage" Property="VisualElement.HeightRequest" Value="104" />
                            <Setter TargetName="PokemonProximoRow" Property="Grid.ColumnDefinitions" Value="112,*" />
                            <Setter TargetName="PokemonProximoImage" Property="VisualElement.WidthRequest" Value="112" />
                            <Setter TargetName="PokemonProximoImage" Property="VisualElement.HeightRequest" Value="112" />
                            <Setter TargetName="PokemonDistanteLabel" Property="Label.FontSize" Value="28" />
                            <Setter TargetName="LinhaDistanteLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="SentidoDistanteLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="HpDistanteLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="PokemonProximoLabel" Property="Label.FontSize" Value="28" />
                            <Setter TargetName="LinhaProximoLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="SentidoProximoLabel" Property="Label.FontSize" Value="18" />
                            <Setter TargetName="HpProximoLabel" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="ResultadoLabel" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="InverterPerspectivaButton" Property="Button.FontSize" Value="18" />
                            <Setter TargetName="NarrationTitle" Property="Label.FontSize" Value="26" />
                            <Setter TargetName="StatusLabel" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="ModeloLabel" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="NarracaoLabel" Property="Label.FontSize" Value="22" />
                            <Setter TargetName="TentarNovamenteButton" Property="Button.FontSize" Value="18" />
                            <Setter TargetName="ConfigurarChaveButton" Property="Button.FontSize" Value="18" />
                            <Setter TargetName="VoltarButton" Property="Button.FontSize" Value="18" />
                            <Setter TargetName="SortearNovamenteButton" Property="Button.FontSize" Value="18" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <!--  CABEÇALHO  -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">

            <Label
                FontFamily="PokemonEmerald"
                FontSize="40"
                HorizontalTextAlignment="Center"
                x:Name="BattleTitle" Text="BATALHA POKÉBUS"
                TextColor="{StaticResource PrimaryColor}" />

            <BoxView HeightRequest="2" Color="{StaticResource PrimaryColor}" />

        </VerticalStackLayout>

        <!--  CONTEÚDO PRINCIPAL  -->
        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            ColumnDefinitions="0.92*,2,1.08*"
            ColumnSpacing="12">


            <!--  CAMPO DE BATALHA  -->
            <Grid x:Name="BattleFieldPanel" Grid.Column="0" RowDefinitions="*,Auto,Auto">


                <!--  POSIÇÕES FIXAS DOS POKÉMON  -->
                <Grid
                    x:Name="BattlePositionsGrid"
                    Grid.Row="0"
                    Margin="55,0,55,0"
                    RowDefinitions="Auto,Auto"
                    VerticalOptions="Center">

                    <!--  POKÉMON DISTANTE: SUPERIOR DIREITO  -->
                    <Grid
                        x:Name="PokemonDistanteRow"
                        Grid.Row="0"
                        ColumnDefinitions="*,216"
                        ColumnSpacing="16"
                        VerticalOptions="End">

                        <VerticalStackLayout
                            x:Name="PokemonDistanteInfo"
                            Grid.Column="0"
                            HorizontalOptions="Fill"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                x:Name="PokemonDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="40"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource PrimaryColor}" />

                            <Label
                                x:Name="LinhaDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="SentidoDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="HpDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="20"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                        <controls:PokemonSpriteView
                            x:Name="PokemonDistanteImage"
                            Grid.Column="1"
                            HeightRequest="216"
                            HorizontalOptions="Center"
                            Url=""
                            VerticalOptions="Center"
                            WidthRequest="216" />

                    </Grid>

                    <!--  POKÉMON PRÓXIMO: INFERIOR ESQUERDO  -->
                    <Grid
                        x:Name="PokemonProximoRow"
                        Grid.Row="1"
                        ColumnDefinitions="288,*"
                        ColumnSpacing="4"
                        VerticalOptions="Start">

                        <controls:PokemonSpriteView
                            x:Name="PokemonProximoImage"
                            Grid.Column="0"
                            HeightRequest="288"
                            HorizontalOptions="Center"
                            Url=""
                            VerticalOptions="Center"
                            WidthRequest="288" />

                        <VerticalStackLayout
                            x:Name="PokemonProximoInfo"
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                x:Name="PokemonProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="40"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource PrimaryColor}" />

                            <Label
                                x:Name="LinhaProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="SentidoProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="HpProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="20"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                    </Grid>

                </Grid>

                <!--  RESULTADO  -->
                <Label
                    x:Name="ResultadoLabel"
                    Grid.Row="1"
                    FontFamily="PokemonEmerald"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource PrimaryColor}" />

                <!--  ALTERNAR PERSPECTIVA  -->
                <Button
                    x:Name="InverterPerspectivaButton"
                    Grid.Row="2"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Clicked="OnInverterPerspectivaClicked"
                    FontFamily="PokemonEmerald"
                    FontSize="24"
                    Text="INVERTER PERSPECTIVA"
                    TextColor="White" />

            </Grid>


            <!--  DIVISÓRIA  -->
            <BoxView
                x:Name="LayoutDivider"
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Fill"
                WidthRequest="2"
                Color="{StaticResource PrimaryColor}" />

            <!--  NARRAÇÃO DO GEMINI  -->
            <Grid
                x:Name="NarrationPanel"
                Grid.Column="2"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="10">

                <!--  TÍTULO  -->
                <VerticalStackLayout Grid.Row="0" Spacing="6">

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        x:Name="NarrationTitle" Text="NARRAÇÃO DA BATALHA"
                        TextColor="{StaticResource PrimaryColor}" />

                    <BoxView HeightRequest="1" Color="{StaticResource PrimaryColor}" />

                </VerticalStackLayout>

                <!--  STATUS  -->
                <VerticalStackLayout Grid.Row="1" Spacing="4">

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsRunning="True"
                        IsVisible="True"
                        Color="{StaticResource PrimaryColor}" />

                    <Label
                        x:Name="StatusLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Text="Aguardando narração..."
                        TextColor="Gray" />

                    <Label
                        x:Name="ModeloLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        TextColor="Gray" />

                </VerticalStackLayout>

                <!--  NARRAÇÃO  -->
                <ScrollView Grid.Row="2" VerticalOptions="FillAndExpand">

                    <Label
                        x:Name="NarracaoLabel"
                        Padding="12,8"
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        LineBreakMode="WordWrap"
                        TextColor="#000000" />

                </ScrollView>

                <!--  CONTROLES  -->
                <VerticalStackLayout Grid.Row="3" Spacing="8">

                    <Button
                        x:Name="TentarNovamenteButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnTentarNovamenteClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        IsVisible="False"
                        Text="TENTAR NOVAMENTE"
                        TextColor="White" />

                    <Button
                        x:Name="ConfigurarChaveButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnConfigurarChaveClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        IsVisible="False"
                        Text="CONFIGURAR CHAVE"
                        TextColor="White" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">

                        <Button
                            x:Name="VoltarButton"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnBackClicked"
                            FontFamily="PokemonEmerald"
                            FontSize="24"
                            Text="VOLTAR"
                            TextColor="White" />

                        <Button
                            x:Name="SortearNovamenteButton"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnSortearNovamenteClicked"
                            FontFamily="PokemonEmerald"
                            FontSize="24"
                            IsVisible="False"
                            Text="SORTEAR NOVAMENTE"
                            TextColor="White" />

                    </Grid>

                </VerticalStackLayout>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>
