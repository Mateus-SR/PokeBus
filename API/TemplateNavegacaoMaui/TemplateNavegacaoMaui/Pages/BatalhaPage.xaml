<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TemplateNavegacaoMaui.Pages.BatalhaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
    Title="Batalha PokéBus"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        Margin="24,10"
        RowDefinitions="Auto,*"
        RowSpacing="10">

        <!--  CABEÇALHO  -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">

            <Label
                FontFamily="PokemonEmerald"
                FontSize="40"
                HorizontalTextAlignment="Center"
                Text="BATALHA POKÉBUS"
                TextColor="{StaticResource PrimaryColor}" />

            <BoxView HeightRequest="2" Color="{StaticResource PrimaryColor}" />

        </VerticalStackLayout>

        <!--  CONTEÚDO PRINCIPAL  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="0.92*,2,1.08*"
            ColumnSpacing="12">


            <!--  CAMPO DE BATALHA  -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto">


                <!--  POSIÇÕES FIXAS DOS POKÉMON  -->
                <Grid
                    Grid.Row="0"
                    Margin="55,0,55,0"
                    RowDefinitions="Auto,Auto"
                    VerticalOptions="Center">

                    <!--  POKÉMON DISTANTE: SUPERIOR DIREITO  -->
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,216"
                        ColumnSpacing="16"
                        VerticalOptions="End">

                        <VerticalStackLayout
                            x:Name="PokemonDistanteInfo"
                            Grid.Column="0"
                            HorizontalOptions="Fill"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                x:Name="PokemonDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="40"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource PrimaryColor}" />

                            <Label
                                x:Name="LinhaDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="SentidoDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="HpDistanteLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="20"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                        <controls:PokemonSpriteView
                            x:Name="PokemonDistanteImage"
                            Grid.Column="1"
                            HeightRequest="216"
                            HorizontalOptions="Center"
                            Url=""
                            VerticalOptions="Center"
                            WidthRequest="216" />

                    </Grid>

                    <!--  POKÉMON PRÓXIMO: INFERIOR ESQUERDO  -->
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="288,*"
                        ColumnSpacing="4"
                        VerticalOptions="Start">

                        <controls:PokemonSpriteView
                            x:Name="PokemonProximoImage"
                            Grid.Column="0"
                            HeightRequest="288"
                            HorizontalOptions="Center"
                            Url=""
                            VerticalOptions="Center"
                            WidthRequest="288" />

                        <VerticalStackLayout
                            x:Name="PokemonProximoInfo"
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                x:Name="PokemonProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="40"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource PrimaryColor}" />

                            <Label
                                x:Name="LinhaProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="SentidoProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="22"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="#000000" />

                            <Label
                                x:Name="HpProximoLabel"
                                FontFamily="PokemonEmerald"
                                FontSize="20"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="WordWrap"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                    </Grid>

                </Grid>

                <!--  RESULTADO  -->
                <Label
                    x:Name="ResultadoLabel"
                    Grid.Row="1"
                    FontFamily="PokemonEmerald"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource PrimaryColor}" />

                <!--  ALTERNAR PERSPECTIVA  -->
                <Button
                    x:Name="InverterPerspectivaButton"
                    Grid.Row="2"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Clicked="OnInverterPerspectivaClicked"
                    FontFamily="PokemonEmerald"
                    FontSize="24"
                    Text="INVERTER PERSPECTIVA"
                    TextColor="White" />

            </Grid>


            <!--  DIVISÓRIA  -->
            <BoxView
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Fill"
                WidthRequest="2"
                Color="{StaticResource PrimaryColor}" />

            <!--  NARRAÇÃO DO GEMINI  -->
            <Grid
                Grid.Column="2"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="10">

                <!--  TÍTULO  -->
                <VerticalStackLayout Grid.Row="0" Spacing="6">

                    <Label
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        Text="NARRAÇÃO DA BATALHA"
                        TextColor="{StaticResource PrimaryColor}" />

                    <BoxView HeightRequest="1" Color="{StaticResource PrimaryColor}" />

                </VerticalStackLayout>

                <!--  STATUS  -->
                <VerticalStackLayout Grid.Row="1" Spacing="4">

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsRunning="True"
                        IsVisible="True"
                        Color="{StaticResource PrimaryColor}" />

                    <Label
                        x:Name="StatusLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Text="Aguardando narração..."
                        TextColor="Gray" />

                </VerticalStackLayout>

                <!--  NARRAÇÃO  -->
                <ScrollView Grid.Row="2" VerticalOptions="FillAndExpand">

                    <Label
                        x:Name="NarracaoLabel"
                        Padding="12,8"
                        FontFamily="PokemonEmerald"
                        FontSize="30"
                        LineBreakMode="WordWrap"
                        TextColor="#000000" />

                </ScrollView>

                <!--  CONTROLES  -->
                <VerticalStackLayout Grid.Row="3" Spacing="8">

                    <Button
                        x:Name="TentarNovamenteButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnTentarNovamenteClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        IsVisible="False"
                        Text="TENTAR NOVAMENTE"
                        TextColor="White" />

                    <Button
                        x:Name="ConfigurarChaveButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnConfigurarChaveClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="24"
                        IsVisible="False"
                        Text="CONFIGURAR CHAVE"
                        TextColor="White" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">

                        <Button
                            x:Name="VoltarButton"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnBackClicked"
                            FontFamily="PokemonEmerald"
                            FontSize="24"
                            Text="VOLTAR"
                            TextColor="White" />

                        <Button
                            x:Name="SortearNovamenteButton"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnSortearNovamenteClicked"
                            FontFamily="PokemonEmerald"
                            FontSize="24"
                            IsVisible="False"
                            Text="SORTEAR NOVAMENTE"
                            TextColor="White" />

                    </Grid>

                </VerticalStackLayout>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>
