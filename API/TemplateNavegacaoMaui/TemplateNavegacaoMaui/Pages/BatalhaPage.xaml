<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
  x:Class="TemplateNavegacaoMaui.Pages.BatalhaPage"
  Title="Batalha PokéBus"
  BackgroundColor="{StaticResource PageBackground}"
>
  <Grid RowDefinitions="Auto,*" Margin="75,10" RowSpacing="12">
    <!-- CABEÇALHO FIXO -->
    <VerticalStackLayout Grid.Row="0">
      <Label
        Text="BATALHA POKÉBUS"
        FontFamily="PokemonEmerald"
        FontSize="38"
        HorizontalTextAlignment="Center"
        TextColor="{StaticResource PrimaryColor}"
      />

      <Grid ColumnDefinitions="*,*">
        <!-- POKÉMON A -->
        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
          <controls:PokemonSpriteView
            x:Name="PokemonAImage"
            WidthRequest="216"
            HeightRequest="216"
            Url=""
            HorizontalOptions="End"
            VerticalOptions="Center"
            ScaleX="-1"
          />

          <Label
            x:Name="PokemonALabel"
            FontFamily="PokemonEmerald"
            FontSize="36"
            HorizontalTextAlignment="Center"
            TextColor="{StaticResource PrimaryColor}"
          />

          <Label
            x:Name="LinhaALabel"
            FontFamily="PokemonEmerald"
            FontSize="26"
            TextColor="#000000"
            HorizontalTextAlignment="Center"
          />

          <Label
            x:Name="SentidoALabel"
            FontFamily="PokemonEmerald"
            FontSize="26"
            TextColor="#000000"
            HorizontalTextAlignment="Center"
          />

          <Label
            x:Name="HpALabel"
            FontFamily="PokemonEmerald"
            FontSize="20"
            TextColor="#000000"
            HorizontalTextAlignment="Center"
          />
        </VerticalStackLayout>

        <!-- POKÉMON B -->
        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
          <controls:PokemonSpriteView
            x:Name="PokemonBImage"
            WidthRequest="216"
            HeightRequest="216"
            Url=""
            HorizontalOptions="End"
            VerticalOptions="Center"
          />

          <Label
            x:Name="PokemonBLabel"
            FontFamily="PokemonEmerald"
            FontSize="36"
            HorizontalTextAlignment="Center"
            TextColor="{StaticResource PrimaryColor}"
          />

          <Label
            x:Name="LinhaBLabel"
            FontFamily="PokemonEmerald"
            FontSize="26"
            TextColor="#000000"
            HorizontalTextAlignment="Center"
          />

          <Label
            x:Name="SentidoBLabel"
            FontFamily="PokemonEmerald"
            FontSize="26"
            TextColor="#000000"
            HorizontalTextAlignment="Center"
          />

          <Label
            x:Name="HpBLabel"
            FontFamily="PokemonEmerald"
            FontSize="20"
            TextColor="#000000"
            HorizontalTextAlignment="Center"
          />
        </VerticalStackLayout>
      </Grid>

      <Label
        x:Name="ResultadoLabel"
        FontFamily="PokemonEmerald"
        FontSize="30"
        HorizontalTextAlignment="Center"
        TextColor="{StaticResource PrimaryColor}"
      />

      <BoxView HeightRequest="2" Color="{StaticResource PrimaryColor}" />
    </VerticalStackLayout>

    <!-- CONTEÚDO ROLÁVEL -->
    <ScrollView Grid.Row="1">
      <VerticalStackLayout>
        <Label
          Text="NARRAÇÃO DA BATALHA"
          FontFamily="PokemonEmerald"
          FontSize="36"
          HorizontalTextAlignment="Center"
          TextColor="{StaticResource PrimaryColor}"
        />

        <ActivityIndicator
          x:Name="LoadingIndicator"
          IsRunning="True"
          IsVisible="True"
          Color="{StaticResource PrimaryColor}"
        />

        <Label
          x:Name="StatusLabel"
          Text="Aguardando narração..."
          FontFamily="PokemonEmerald"
          FontSize="30"
          HorizontalTextAlignment="Center"
          TextColor="Gray"
        />

        <Label
          x:Name="NarracaoLabel"
          FontFamily="PokemonEmerald"
          FontSize="30"
          LineBreakMode="WordWrap"
          TextColor="#000000"
          Padding="75,10"
        />

        <Button
          x:Name="TentarNovamenteButton"
          Text="TENTAR NOVAMENTE"
          Clicked="OnTentarNovamenteClicked"
          IsVisible="False"
          BackgroundColor="{StaticResource PrimaryColor}"
          TextColor="White"
          FontSize="34"
          FontFamily="PokemonEmerald"
        />

        <Button
          x:Name="SortearNovamenteButton"
          Text="SORTEAR NOVAMENTE"
          Clicked="OnSortearNovamenteClicked"
          IsVisible="False"
          BackgroundColor="{StaticResource PrimaryColor}"
          TextColor="White"
          FontSize="34"
          FontFamily="PokemonEmerald"
        />
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
