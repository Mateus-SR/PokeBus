<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TemplateNavegacaoMaui.Pages.BatalhaPage"
    Title="Batalha PokéBus"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="BATALHA POKÉBUS"
                   FontFamily="PokemonEmerald"
                   FontSize="38"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource PrimaryColor}" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <VerticalStackLayout Grid.Column="0"
                                     Spacing="5"
                                     HorizontalOptions="Center">

                    <Image x:Name="PokemonAImage"
                           HeightRequest="150"
                           WidthRequest="150"
                           Aspect="AspectFit" />

                    <Label x:Name="PokemonALabel"
                           FontFamily="PokemonEmerald"
                           FontSize="24"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource PrimaryColor}" />

                    <Label x:Name="LinhaALabel"
                           FontFamily="PokemonEmerald"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="HpALabel"
                           FontFamily="PokemonEmerald"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="5"
                                     HorizontalOptions="Center">

                    <Image x:Name="PokemonBImage"
                           HeightRequest="150"
                           WidthRequest="150"
                           Aspect="AspectFit" />

                    <Label x:Name="PokemonBLabel"
                           FontFamily="PokemonEmerald"
                           FontSize="24"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource PrimaryColor}" />

                    <Label x:Name="LinhaBLabel"
                           FontFamily="PokemonEmerald"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="HpBLabel"
                           FontFamily="PokemonEmerald"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Grid>

            <Label x:Name="ResultadoLabel"
                   FontFamily="PokemonEmerald"
                   FontSize="30"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource PrimaryColor}" />

            <BoxView HeightRequest="2"
                     Color="{StaticResource PrimaryColor}" />

            <Label Text="NARRAÇÃO DA BATALHA"
                   FontFamily="PokemonEmerald"
                   FontSize="28"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource PrimaryColor}" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               Color="{StaticResource PrimaryColor}" />

            <Label x:Name="StatusLabel"
                   Text="Aguardando narração..."
                   FontFamily="PokemonEmerald"
                   FontSize="20"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

            <Label x:Name="NarracaoLabel"
                   FontFamily="PokemonEmerald"
                   FontSize="20"
                   LineBreakMode="WordWrap"
                   TextColor="{StaticResource PrimaryColor}" />

            <Button
    x:Name="TentarNovamenteButton"
    Text="TENTAR NOVAMENTE"
    Clicked="OnTentarNovamenteClicked"
    IsVisible="False"
    BackgroundColor="{StaticResource Primary}"
    TextColor="White"
    FontFamily="PokemonEmerald" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
