<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TemplateNavegacaoMaui.Pages.BatalhaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TemplateNavegacaoMaui.Controls"
    Title="Batalha PokéBus"
    BackgroundColor="{StaticResource PageBackground}">
    <Grid
        Margin="75,10"
        RowDefinitions="Auto,*"
        RowSpacing="12">
        <!--  CABEÇALHO FIXO  -->
        <VerticalStackLayout Grid.Row="0">
            <Label
                FontFamily="PokemonEmerald"
                FontSize="38"
                HorizontalTextAlignment="Center"
                Text="BATALHA POKÉBUS"
                TextColor="{StaticResource PrimaryColor}" />

            <Grid ColumnDefinitions="*,*">
                <!--  POKÉMON A  -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <controls:PokemonSpriteView
                        x:Name="PokemonAImage"
                        HeightRequest="216"
                        HorizontalOptions="End"
                        ScaleX="-1"
                        Url=""
                        VerticalOptions="Center"
                        WidthRequest="216" />

                    <Label
                        x:Name="PokemonALabel"
                        FontFamily="PokemonEmerald"
                        FontSize="36"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryColor}" />

                    <Label
                        x:Name="LinhaALabel"
                        FontFamily="PokemonEmerald"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        TextColor="#000000" />

                    <Label
                        x:Name="SentidoALabel"
                        FontFamily="PokemonEmerald"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        TextColor="#000000" />

                    <Label
                        x:Name="HpALabel"
                        FontFamily="PokemonEmerald"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        TextColor="#000000" />
                </VerticalStackLayout>

                <!--  POKÉMON B  -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <controls:PokemonSpriteView
                        x:Name="PokemonBImage"
                        HeightRequest="216"
                        HorizontalOptions="End"
                        Url=""
                        VerticalOptions="Center"
                        WidthRequest="216" />

                    <Label
                        x:Name="PokemonBLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="36"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryColor}" />

                    <Label
                        x:Name="LinhaBLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        TextColor="#000000" />

                    <Label
                        x:Name="SentidoBLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        TextColor="#000000" />

                    <Label
                        x:Name="HpBLabel"
                        FontFamily="PokemonEmerald"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        TextColor="#000000" />
                </VerticalStackLayout>
            </Grid>

            <Label
                x:Name="ResultadoLabel"
                FontFamily="PokemonEmerald"
                FontSize="30"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource PrimaryColor}" />

            <BoxView HeightRequest="2" Color="{StaticResource PrimaryColor}" />
        </VerticalStackLayout>

        <!--  CONTEÚDO ROLÁVEL  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Label
                    FontFamily="PokemonEmerald"
                    FontSize="36"
                    HorizontalTextAlignment="Center"
                    Text="NARRAÇÃO DA BATALHA"
                    TextColor="{StaticResource PrimaryColor}" />

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="True"
                    IsVisible="True"
                    Color="{StaticResource PrimaryColor}" />

                <Label
                    x:Name="StatusLabel"
                    FontFamily="PokemonEmerald"
                    FontSize="30"
                    HorizontalTextAlignment="Center"
                    Text="Aguardando narração..."
                    TextColor="Gray" />

                <Label
                    x:Name="NarracaoLabel"
                    Padding="75,10"
                    FontFamily="PokemonEmerald"
                    FontSize="30"
                    LineBreakMode="WordWrap"
                    TextColor="#000000" />

                <Button
                    x:Name="TentarNovamenteButton"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Clicked="OnTentarNovamenteClicked"
                    FontFamily="PokemonEmerald"
                    FontSize="34"
                    IsVisible="False"
                    Text="TENTAR NOVAMENTE"
                    TextColor="White" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Button
                        x:Name="VoltarButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnBackClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="34"
                        Text="VOLTAR"
                        TextColor="White" />
                    <Button
                        x:Name="SortearNovamenteButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnSortearNovamenteClicked"
                        FontFamily="PokemonEmerald"
                        FontSize="34"
                        IsVisible="False"
                        Text="SORTEAR NOVAMENTE"
                        TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
